# Все текстовые файлы — LF в репозитории, автоконвертация на Windows
* text=auto eol=lf

# Явно указываем текстовые форматы
*.py    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Бинарные файлы — без конвертации
*.png   binary
*.jpg   binary
*.jar   binary
